{
  "schemaVersion": 1,
  "id": "reroll-trades",
  "version": "${version}",
  "name": "Reroll Trades",
  "description": "Reroll and undo villager trades for free, with server-side limits and configurable controls.",
  "authors": [
    "misemise"
  ],
  "contact": {
    "sources": "https://github.com/misemise/reroll-trades"
  },
  "license": "MIT",
  "icon": "assets/reroll-trades/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.misemise.fabric.RerollTradesFabric"
    ],
    "client": [
      "net.misemise.fabric.RerollTradesFabricClient"
    ],
    "modmenu": [
      "net.misemise.fabric.RerollTradesModMenu"
    ]
  },
  "mixins": [
    "reroll-trades.mixins.json",
    "reroll-trades.client-mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  }
}
